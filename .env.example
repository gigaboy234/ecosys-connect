# ── ВКонтакте ────────────────────────────────────────────────────────────────
# Токен группы: Управление → Работа с API → Создать ключ доступа
# Нужные права: Сообщения, Фотографии
VK_TOKEN=vk1.a.your_group_token_here
VK_GROUP_ID=123456789
ADMIN_VK_IDS=111111111,222222222

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecosys
POSTGRES_USER=ecosys
POSTGRES_PASSWORD=change_me_in_production

# ── (опционально) PostgreSQL через единый URL ─────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://ecosys:secret@postgres:5432/ecosys
